{
    "bot_name": "daytrader",
    "strategy": "DayTraderV1",
    "max_open_trades": 5,
    "stake_amount": 10,
    "unfilledtimeout": {
        "entry": 2,
        "exit": 2,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "pair_whitelist": [],
        "pair_blacklist": [
            "(USDC|USDT|EURC|EURT|DAI|PYUSD|EURQ|EURR|USDQ|USDR)/.*",
            ".*(UP|DOWN|BULL|BEAR)/.*"
        ]
    },
    "pairlists": [
        {
            "method": "VolumePairList",
            "number_assets": 60,
            "sort_key": "quoteVolume",
            "min_value": 200000,
            "refresh_period": 1800
        },
        {"method": "AgeFilter", "min_days_listed": 14},
        {"method": "PriceFilter", "low_price_ratio": 0.002},
        {"method": "SpreadFilter", "max_spread_ratio": 0.005},
        {"method": "VolumePairList", "number_assets": 40, "sort_key": "quoteVolume"}
    ],
    "telegram": {
        "enabled": false
    },
    "webhook": {
        "enabled": true,
        "url": "https://api.telegram.org/bot/sendMessage",
        "format": "json",
        "retries": 1,
        "entry_fill": {
            "chat_id": "",
            "text": "Daytrader KAUF {pair} ({enter_tag}) zu {open_rate:.6g}, {stake_amount:.2f} EUR"
        },
        "exit_fill": {
            "chat_id": "",
            "text": "Daytrader VERKAUF {pair} ({exit_reason}): {profit_ratio:+.2%} = {profit_amount:+.2f} EUR"
        },
        "status": {
            "chat_id": "",
            "text": "Daytrader: {status}"
        },
        "strategy_msg": {
            "chat_id": "",
            "text": "{msg}"
        },
        "protection_trigger_global": {
            "chat_id": "",
            "text": "Daytrader Pause: {reason}, bis {lock_end_time}"
        }
    }
}
